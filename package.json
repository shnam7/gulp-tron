{
  "name": "gulp-tron-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shnam7/gulp-tron"
  },
  "keywords": [
    "gulp",
    "task",
    "build",
    "builder",
    "manager"
  ],
  "scripts": {
    "dev": "turbo dev --filter=gulp-tron --filter=@gulp-tron/plugin-*",
    "dev:tron": "turbo dev --filter=gulp-tron",
    "build": "turbo run build",
    "build:tron": "turbo run build --filter=gulp-tron",
    "build:pkg": "turbo run build --filter=gulp-tron --filter=@gulp-tron/plugin-*",
    "build:examples": "turbo build --filter=./examples/*",
    "lint": "turbo run lint",
    "lint:tron": "turbo run lint --filter=gulp-tron",
    "lint:pkg": "turbo run lint --filter=gulp-tron --filter=@gulp-tron/plugin-*",
    "lint:examples": "turbo run lint --filter=./examples/*",
    "test": "turbo run test",
    "test:tron": "turbo run test --filter=gulp-tron ",
    "test:pkg": "turbo run test --filter=gulp-tron --filter=@gulp-tron/plugin-*",
    "clean": "run-s clean:examples clean:pkg",
    "clean:tron": "turbo clean --filter=gulp-tron",
    "clean:pkg": "turbo clean --filter=gulp-tron --filter=@gulp-tron/plugin-*",
    "clean:examples": "turbo run clean --filter=./examples/*",
    "prepare-to-commit": "run-s lint build test clean",
    "reset": "npm-run-all -s clean reset:turbo reset:node",
    "reset:turbo": "find . -type d -name .turbo -exec rm -rf {} +",
    "reset:node": "find . -type d -name node_modules -exec rm -rf {} +"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@wicle/is": "^2.1.1",
    "npm-run-all": "^4.1.5",
    "turbo": "^2.10.13"
  },
  "packageManager": "bun@1.4.2"
}
