{
  "name": "@gulp-tron/plugin-styles",
  "version": "0.1.1",
  "type": "module",
  "author": "Robin Nam",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "dev": "run-s build watch",
    "dev:test": "vitest watch --coverage --coverage.include=src",
    "build": "run-p build:**",
    "build:ts": "tsdown",
    "build:ts:types": "tsc --noEmit ",
    "lint": "run-p lint:*",
    "lint:ts": "biome check",
    "lint:ts:types": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.include=src",
    "watch": "chokidar 'src/**' -c 'run-p \"build:ts --no-clean\" build:ts:types'",
    "clean": "rimraf ./dist ./coverage",
    "prepare-to-commit": "run-s clean lint test build clean",
    "prepublishOnly": "bun run build",
    "npm-dry-run": "npm publish --dry-run",
    "reset": "run-s clean reset:turbo reset:node",
    "reset:turbo": "find . -type d -name .turbo -exec rm -rf {} +",
    "reset:node": "find . -type d -name node_modules -exec rm -rf {} +"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shnam7/gulp-tron",
    "directory": "packages/plugin-scripts"
  },
  "bugs": {
    "url": "https://github.com/shnam7/gulp-tron/issues"
  },
  "homepage": "https://github.com/shnam7/gulp-tron/blob/main/packages/plugin-styles#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gulp",
    "task",
    "build",
    "builder",
    "manager",
    "style",
    "autoprefix",
    "clean-css",
    "sass",
    "scss",
    "less",
    "postcss",
    "stylelint",
    "rtlcss"
  ],
  "dependencies": {
    "@wicle/is": "^2.1.1",
    "clean-css": "^5.3.3",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-less": "^5.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-rtlcss": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "postcss": "^8.5.28",
    "postcss-less": "^6.0.0",
    "postcss-reporter": "^7.1.0",
    "postcss-sass": "^0.5.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0"
  },
  "devDependencies": {
    "@gulp-tron/tsconfig": "workspace:*",
    "@types/clean-css": "^4.2.11",
    "@types/gulp-autoprefixer": "^10.0.0",
    "@types/gulp-clean-css": "^4.3.4",
    "@types/gulp-less": "^0.0.36",
    "@types/gulp-postcss": "^8.0.6",
    "@types/gulp-sass": "^6.0.0",
    "@types/postcss-less": "^4.0.7",
    "@types/postcss-reporter": "^7.0.5",
    "@types/postcss-sass": "^0.5.0",
    "@types/rtlcss": "^3.5.4",
    "@vitest/coverage-v8": "^5.0.1",
    "chokidar-cli": "^3.0.0",
    "gulp-tron": "workspace:*",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
