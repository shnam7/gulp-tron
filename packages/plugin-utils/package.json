{
  "name": "@gulp-tron/plugin-utils",
  "version": "0.1.1",
  "type": "module",
  "author": "Robin Nam",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "dev": "run-s build watch",
    "dev:test": "vitest watch --coverage --coverage.include=src",
    "build": "run-p build:**",
    "build:ts": "tsdown",
    "build:ts:types": "tsc --noEmit ",
    "lint": "run-p lint:*",
    "lint:ts": "biome check",
    "lint:ts:types": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.include=src",
    "watch": "chokidar 'src/**' -c 'run-p \"build:ts --no-clean\" build:ts:types'",
    "clean": "rimraf ./dist ./coverage",
    "prepare-to-commit": "run-s clean lint test build clean",
    "prepublishOnly": "bun run build",
    "npm-dry-run": "npm publish --dry-run",
    "reset": "run-s clean reset:turbo reset:node",
    "reset:turbo": "find . -type d -name .turbo -exec rm -rf {} +",
    "reset:node": "find . -type d -name node_modules -exec rm -rf {} +"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shnam7/gulp-tron",
    "directory": "packages/plugin-scripts"
  },
  "bugs": {
    "url": "https://github.com/shnam7/gulp-tron/issues"
  },
  "homepage": "https://github.com/shnam7/gulp-tron/blob/main/packages/plugin-utils#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gulp",
    "task",
    "build",
    "builder",
    "manager",
    "data",
    "json",
    "yaml"
  ],
  "dependencies": {
    "js-yaml": "^5.4.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@gulp-tron/tsconfig": "workspace:*",
    "@types/gulp-concat": "^0.0.37",
    "@types/gulp-imagemin": "^8.0.6",
    "@types/imagemin": "^9.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/through2": "^5.0.0",
    "@types/vinyl": "^2.0.12",
    "@vitest/coverage-v8": "^5.0.1",
    "chokidar-cli": "^3.0.0",
    "gulp-tron": "workspace:*",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vinyl": "^3.0.1",
    "vitest": "^5.0.1"
  }
}
