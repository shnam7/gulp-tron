{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "cache": true,
      "inputs": ["src/**", "tsconfig.json", "tsdown.config.ts", "gulpfile.js"],
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
